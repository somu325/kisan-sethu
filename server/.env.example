# ====================================================================
# KisanSetu Server Environment Configuration
# ====================================================================

# Server Settings
PORT=8080
NODE_ENV=development
CORS_ORIGIN=*
ADMIN_API_KEY=ks-admin-secret-dev-key

# Database Settings
# DB_PROVIDER: 'sqlite' | 'postgres' | 'firestore'
DB_PROVIDER=sqlite
# For SQLite (default local development):
DATABASE_URL=./data/kisansetu.db
# For PostgreSQL (Google Cloud SQL, Supabase, Neon, local Docker):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/kisansetu
DB_TIMEOUT_MS=5000
DB_MAX_CONNECTIONS=10

# Swappable LLM Gateway
LLM_PRIMARY_PROVIDER=gemini
# API Keys (leave empty to disable a provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# Debugging / Overrides (leave empty for automatic tier routing)
LLM_FORCE_MODEL=

# Cost & Budget Guardrails
LLM_DAILY_COST_CAP_USD=10.00
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
