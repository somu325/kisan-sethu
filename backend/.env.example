# ==============================================================================
# Kisan Sethu Backend - Environment Configuration
# ==============================================================================
# All environment variables in Kisan Sethu use the 'KS_' prefix.
# Copy this file to '.env' and substitute your keys as needed.
# If keys are left as 'your_*_key_here' or blank, the service operates in
# safe, deterministic offline mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server Environment
# ------------------------------------------------------------------------------
KS_ENV=local

# ------------------------------------------------------------------------------
# 2. Large Language Model (Gemini / Vertex AI)
# ------------------------------------------------------------------------------
# Google AI Studio Gemini API Key (e.g. AIzaSy...)
# If left as placeholder or empty, backend uses offline deterministic fallback.
KS_GEMINI_API_KEY=your_gemini_api_key_here

# Fast and Strong model identifiers (Google GenAI)
KS_MODEL_FAST=gemini-2.5-flash
KS_MODEL_STRONG=gemini-2.5-pro

# ------------------------------------------------------------------------------
# 3. Location & Geocoding Services
# ------------------------------------------------------------------------------
# Google Maps Geocoding API Key (optional)
# If empty or placeholder, built-in coordinates for major agricultural mandis are used.
KS_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 4. External Mandi Data Ingestion (data.gov.in / AGMARKNET)
# ------------------------------------------------------------------------------
# Official data.gov.in API Key for daily mandi prices
# If empty or placeholder, bundled static sample records are used for development.
KS_DATA_GOV_API_KEY=your_data_gov_in_api_key_here
KS_DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# ------------------------------------------------------------------------------
# 5. RAG & Vector Store Configuration
# ------------------------------------------------------------------------------
# Vector store type: 'local' (JSON file), 'vertex' (Vertex Vector Search), or 'bigquery'
KS_VECTOR_STORE_TYPE=local
KS_VECTOR_STORE_PATH=data/rag_docs/vector_store.json
KS_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# 6. Google Sheets Audit Trail Logging (Optional)
# ------------------------------------------------------------------------------
# Google Sheets ID to log daily ingested mandi prices
KS_GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheets_spreadsheet_id_here
# Path to GCP service account key JSON file
KS_GOOGLE_SERVICE_ACCOUNT_PATH=path/to/service_account.json

# ------------------------------------------------------------------------------
# 7. Enterprise GCP / Vertex AI Infrastructure (Optional)
# ------------------------------------------------------------------------------
KS_GCP_PROJECT_ID=your_gcp_project_id_here
KS_GCP_LOCATION=asia-south1
KS_GCS_STAGING_BUCKET=your_gcs_staging_bucket_here

# Vertex AI Matching Engine / Vector Search (Optional enterprise mode)
KS_VERTEX_INDEX_ID=your_vertex_index_id_here
KS_VERTEX_ENDPOINT_ID=your_vertex_endpoint_id_here
KS_VERTEX_DEPLOYED_INDEX_ID=your_vertex_deployed_index_id_here

# BigQuery Integration (Optional)
KS_BIGQUERY_DATASET=your_bigquery_dataset_here
KS_BIGQUERY_TABLE=your_bigquery_table_here

# ------------------------------------------------------------------------------
# 8. Pesticide & Spray Dosage Verification
# ------------------------------------------------------------------------------
# Data source switch: 'local' (seed JSON files) or 'api' (external database)
KS_PESTICIDE_DATA_SOURCE=local
