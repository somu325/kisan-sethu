{
  "name": "kisan-sethu",
  "version": "1.0.0",
  "private": true,
  "description": "Kisan Sethu monorepo root",
  "scripts": {
    "web": "npm --prefix frontend run web",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test",
    "test:server": "npm --prefix server test",
    "test:all": "npm --prefix frontend test && npm --prefix server test",
    "server": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server start",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "db:reset": "npm --prefix server run db:reset",
    "eval:pesticide": "node scripts/eval_pesticide.mjs",
    "start": "npm --prefix frontend run dev",
    "frontend": "npm --prefix frontend run dev",
    "lint": "npm --prefix frontend run lint"
  }
}
